{
  "name": "Drosophila Trader v2.0",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // Codespaces: everything lives on ONE port - 8000 serves the dashboard, the
  // API, the WebSocket stream, /matrix, /settings, /docs and the Flutter build
  // at /flutter.  Nothing else needs forwarding, and ports you start by hand
  // (a Flutter dev server, a scratch tool) stay silent instead of popping a
  // broken preview.
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // Auto-start on attach: `--bg` is idempotent, so this both starts the app the
  // first time and simply prints the URL on every later attach.  The result is
  // that the forwarded port always has something answering it (a port with no
  // listener is what the browser reports as HTTP 502).
  "postAttachCommand": "bash -lc 'bash run.sh --bg >/dev/null 2>&1; bash run.sh --urls'",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Drosophila Trader - everything (dashboard, API, WS, /flutter)",
      "onAutoForward": "openPreview"
    }
  },
  // Any other port you start by hand (flutter run, a scratch tool) is left
  // alone instead of auto-opening a preview that cannot work.
  "otherPortsAttributes": { "onAutoForward": "silent" },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["backend/tests"],
        "files.exclude": { "**/__pycache__": true }
      }
    }
  },
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}",
    "PYTHONUNBUFFERED": "1"
  }
}
