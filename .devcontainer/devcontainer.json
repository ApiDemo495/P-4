{
  "name": "Drosophila Trader v2.0",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // Codespaces: the app listens on 8000 (dashboard + API + /ws/signals) and
  // 8081 (optional Flutter web build). Both are auto-forwarded.
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8000, 6379],
  "portsAttributes": {
    "8000": {
      "label": "Drosophila Trader (API + dashboard)",
      "onAutoForward": "openPreview"
    },
    "6379": { "label": "Redis", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["backend/tests"],
        "files.exclude": { "**/__pycache__": true }
      }
    }
  },
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}",
    "PYTHONUNBUFFERED": "1"
  }
}
