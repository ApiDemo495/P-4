{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auto-start (runs when the folder opens)",
      "detail": "Fourth belt after the three devcontainer hooks: self-update, provision if needed, (re)start the engine, print the URL",
      "type": "shell",
      "command": "bash tools/codespace_autostart.sh --attach",
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "\u25b6 Start engine + dashboard",
      "detail": "Sets up Python if needed, starts the API, the 60-second cycle and the dashboard on port 8000",
      "type": "shell",
      "command": "bash run.sh --bg && sleep 1 && bash run.sh --urls",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Show server log",
      "type": "shell",
      "command": "tail -f server.log",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Stop everything (free the ports)",
      "detail": "Stops the engine and any stray dev servers, then reports what still listens",
      "type": "shell",
      "command": "bash run.sh --clean",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Environment check (run.sh --check)",
      "type": "shell",
      "command": "bash run.sh --check",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Run tests (Appendix E)",
      "type": "shell",
      "command": "PYTHONPATH=$PWD .venv/bin/python -m pytest -q || PYTHONPATH=$PWD python3 -m pytest -q",
      "problemMatcher": [],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
