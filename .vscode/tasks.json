{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶ Start engine + dashboard",
      "detail": "Sets up Python if needed, starts the API, the 60-second cycle and the dashboard on port 8000",
      "type": "shell",
      "command": "bash run.sh --bg && sleep 1 && echo 'Open the PORTS tab -> port 8000 (globe icon)'",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Stop engine",
      "type": "shell",
      "command": "pkill -f 'backend.api.main' && echo stopped || echo 'nothing was running'",
      "problemMatcher": []
    },
    {
      "label": "Show server log",
      "type": "shell",
      "command": "tail -f server.log",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "Environment check (run.sh --check)",
      "type": "shell",
      "command": "bash run.sh --check",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Run tests (Appendix E)",
      "type": "shell",
      "command": "PYTHONPATH=$PWD .venv/bin/python -m pytest -q || PYTHONPATH=$PWD python3 -m pytest -q",
      "problemMatcher": [],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Build Flutter web app",
      "detail": "Builds frontend/build/web, which the engine then serves at /flutter",
      "type": "shell",
      "command": "bash frontend/run_web.sh",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
