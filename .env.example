# =============================================================================
# DROSOPHILA TRADER v2.0 — environment template
# Copy to .env and fill in what you have. EVERY key below is OPTIONAL:
# the app degrades gracefully (see docs/SPECIFICATION_v2.md Section 13.2).
# =============================================================================

# ---- Server ----
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ---- Drosophila brain (neuPrint / FlyWire) ----
# https://neuprint.janelia.org -> account -> token. If unset, the brain module
# automatically falls back to the committed 80x80 CSV matrix (Step 5).
NEUPRINT_APPLICATION_CREDENTIALS=
NEUPRINT_SERVER=https://neuprint.janelia.org
NEUPRINT_DATASET=hemibrain:v1.2.1
CAVE_TOKEN=
CAVE_SERVER=https://global.daf-apis.com
CAVE_DATASET=flywire_fafb_production
# Set to 1 to skip every network attempt and go straight to the CSV matrix.
BRAIN_FORCE_FALLBACK=0

# ---- AI agents (all optional) ----
# Every key has three slots.  Slot 1 (the plain name) is the PRIMARY and is
# always preferred; _2 and _3 are temporary stand-ins the engine fails over to
# when the primary is rejected / rate limited / erroring, and it returns to
# the primary as soon as its cooldown ends.  Leave any slot empty.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=auto
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_TOKEN_2=
GITHUB_MODELS_TOKEN_3=
GITHUB_MODELS_MODEL=gpt-4o-mini

# ---- News sources (all optional; RSS needs no key) ----
CRYPTOPANIC_API_KEY=
CRYPTOPANIC_API_KEY_2=
CRYPTOPANIC_API_KEY_3=
NEWSAPI_API_KEY=
NEWSAPI_API_KEY_2=
NEWSAPI_API_KEY_3=
NEWS_ENABLED=1
NEWS_POLL_SECONDS=30
RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://www.theblock.co/rss.xml,https://feeds.bbci.co.uk/news/world/rss.xml,https://www.aljazeera.com/xml/rss/all.xml,https://www.federalreserve.gov/feeds/press_all.xml,https://www.cnbc.com/id/100727362/device/rss/rss.html,https://news.google.com/rss/search?q=war+OR+sanctions+OR+tariffs+OR+%22rate+cut%22+OR+%22rate+hike%22+OR+gold+price&hl=en-US&gl=US&ceid=US:en

# ---- Market data ----
# auto | binance | coingecko | simulator
MARKET_DATA_MODE=auto
# When Binance/CoinGecko are unreachable, fall back to the built-in simulator
# instead of forcing HOLD. Set to 0 for strict spec behaviour (Level 6).
MARKET_ALLOW_SIMULATOR=1
SIMULATOR_SEED=1337

# ---- Persistence ----
REDIS_URL=redis://localhost:6379/0

# ---- Cycle timing ----
# The window is 60 seconds, phase-locked to the UTC minute: the countdown the
# dashboard shows goes 60 -> 1 and every panel refreshes on the grid inside it
# (t+15, t+30, t+45).  CYCLE_SECONDS overrides the length; TIME_SCALE compresses
# it for demos/tests (>1 = faster: TIME_SCALE=10 -> a 6-second window).
CYCLE_SECONDS=60.0
TIME_SCALE=1.0
LOCK_DEADLINE_SECONDS=8.0
# Round L: the fast half (tape, 22 formulas, crowd, fusion) is frozen again this
# many seconds before the boundary, so the prediction is built on fresh data.
FINAL_LOCK_LEAD_SECONDS=0.4
FORMULA_REFRESH_SECONDS=15.0
# Blank/0 = "as long as its own window" (60 s + a 5 s publishing grace).
PREDICTION_MAX_AGE_SECONDS=0
# Blank/0 = score a prediction one window after it fires.
OUTCOME_HORIZON_SECONDS=0

# ---- Crowd emotions (Round J) ----
# How often the live tape is scored for the eight emotions (the EMOTION stream).
EMOTION_INTERVAL_SECONDS=0.5
# Samples kept for the panel's history (720 x 0.5 s = six minutes).
EMOTION_HISTORY_SIZE=720

# ---- CORS (comma separated; * allowed for local dev) ----
CORS_ORIGINS=*

# Learned reliability (Round N).  The engine scores every locked window
# against the tape and keeps a decayed hit/miss record per directional source
# (each formula, the brain, each agent, news, crowd tone, microstructure).
# After CALIBRATION_MIN_SAMPLES scored windows on an asset the reliability-
# weighted vote decides the side and the printed confidence is the realised
# hit rate of that confidence bucket; it hands back to the spec recipe if its
# own record falls behind.  HALF_LIFE = windows until old evidence weighs half.
CALIBRATION_ENABLED=1
CALIBRATION_MIN_SAMPLES=30
CALIBRATION_HALF_LIFE=120

# Every formula is double-checked on every pass (replay on a private state
# copy, re-derivation from its traced intermediates, range).  Set 0 to skip.
FORMULA_DOUBLE_CHECK=1
